    --mount=type=bind,from=ghcr.io/vexxhost/build-utils:latest@sha256:f61678dc870ac787616ae8c963e1302df275ff15c9df43dc17de3723595256b5,source=/bin,target=/build \
    /build/install-bindep-packages
